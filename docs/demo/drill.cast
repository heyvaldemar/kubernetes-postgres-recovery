[0.008, "o", "\u001b[1m$ make test\u001b[0m\r\n"]
[0.110, "o", "\r\n== 1. the cluster\r\n"]
[0.498, "o", "  ok    three instances ready, pg-1 the primary\r\n"]
[0.597, "o", "  ok    two standbys streaming; a commit waits for one of them (ANY 1 (\"pg-2\",\"pg-3\",\"pg-1\"))\r\n\r\n== 2. backups\r\n"]
[0.050, "o", "  ok    continuous WAL archiving to the bucket\r\n"]
[0.062, "o", "  ok    base backup daily-20261014172404 completed\r\n"]
[0.356, "o", "  ok    the bucket holds base backups and WAL for pg\r\n\r\n"]
[0.000, "o", "== 3. point in time\r\n"]
[3.525, "o", "  target 2026-10-14 17:31:45.448330+00; row 101 after it; then DROP TABLE\r\n"]
[2.362, "o", "  ok    the WAL up to the DROP is in the bucket\r\n"]
[48.942, "o", "  ..    point-in-time restore: ready in 48s\r\n"]
[0.150, "o", "  ok    restored to the target: the 100 rows before it, not row 101, and the table the DROP removed\r\n"]
[0.044, "o", "\r\n== 4. failover under writes\r\n"]
[6.986, "o", "  killed pg-1 with 29 writes acknowledged\r\n"]
[4.380, "o", "  ..    failover: the operator named a new primary 4s after the kill\r\n"]
[10.096, "o", "  ok    pg-2 took over from pg-1\r\n"]
[0.104, "o", "  ok    all 70 acknowledged writes are on the new primary\r\n"]
[0.048, "o", "  ..    failover: the longest stretch without an acknowledged write was 5.6s (11 writes refused or timed out)\r\n"]
[2.147, "o", "  ok    pg-1 came back as a standby; three instances ready\r\n"]
[0.000, "o", "\r\n== 5. disaster\r\n"]
[48.790, "o", "  ok    archive_timeout shipped the last write's WAL within 48s, without a forced switch\r\n"]
[8.299, "o", "  ok    pg and its volumes are gone\r\n"]
[49.281, "o", "  ..    restore from the bucket alone: ready in 50s\r\n"]
[0.141, "o", "  ok    the restored cluster has the 50 rows written before the loss\r\n\r\n== 6. Ready is not backed up\r\n"]
[59.346, "o", "  ok    pg, created again over the old path, is Ready and does not archive: 'Expected empty archive'\r\n\r\nPASS  three instances ready, pg-1 the primary\r\nPASS  two standbys streaming; a commit waits for one of them (ANY 1 (\"pg-2\",\"pg-3\",\"pg-1\"))\r\nPASS  continuous WAL archiving to the bucket\r\nPASS  base backup daily-20261014172404 completed\r\nPASS  the bucket holds base backups and WAL for pg\r\nPASS  the WAL up to the DROP is in the bucket\r\nPASS  restored to the target: the 100 rows before it, not row 101, and the table the DROP removed\r\nPASS  pg-2 took over from pg-1\r\nPASS  all 70 acknowledged writes are on the new primary\r\nPASS  pg-1 came back as a standby; three instances ready\r\nPASS  archive_timeout shipped the last write's WAL within 48s, without a forced switch\r\nPASS  pg and its volumes are gone\r\nPASS  the restored cluster has the 50 rows written before the loss\r\nPASS  pg, created again over the old path, is Ready and does not archive: 'Expected empty archive'\r\n\r\npoint-in-time restore: ready in 48s\r\nfailover:"]
